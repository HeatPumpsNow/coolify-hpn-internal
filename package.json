    "@types/redis": "^4.0.10",
    "@types/validator": "^13.15.2",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.0",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "^5.8.2",
    "validator": "^13.15.15"
  },
