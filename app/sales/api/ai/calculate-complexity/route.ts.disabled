import { NextRequest, NextResponse } from 'next/server';
import { Anthropic } from '@anthropic-ai/sdk';

// Initialize Claude API
const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
});

const AI_MODEL = process.env.AI_MODEL || 'claude-3-haiku-20240307';
const AI_FEATURES_ENABLED = process.env.AI_FEATURES_ENABLED === 'true';

export async function POST(request: NextRequest) {
  try {
    // Check if AI features are enabled
    if (!AI_FEATURES_ENABLED) {
      return NextResponse.json(
        { success: false, error: 'AI features are currently disabled' },
        { status: 503 }
      );
    }

    // Check API key
    if (!process.env.ANTHROPIC_API_KEY) {
      return NextResponse.json(
        { success: false, error: 'AI service not configured' },
        { status: 503 }
      );
    }

    const { projectInfo } = await request.json();

    if (!projectInfo) {
      return NextResponse.json(
        { success: false, error: 'Project information is required' },
        { status: 400 }
      );
    }

    const prompt = `
You are an HVAC pricing specialist. Analyze this project and determine a complexity multiplier for labor pricing.

Project Information:
${JSON.stringify(projectInfo, null, 2)}

Complexity Multiplier Guidelines:
- Base multiplier: 1.0 (standard installation)
- Range: 0.8 (simple) to 1.5 (very complex)

Factors that INCREASE complexity (add to multiplier):
- Old building (50+ years): +0.1 to +0.2
- Difficult access (crawl space, tight attic): +0.1 to +0.3
- Multi-story installation: +0.1 to +0.2
- Existing ductwork issues: +0.1 to +0.3
- Electrical upgrades needed: +0.1 to +0.2
- Zoning requirements: +0.1 to +0.2
- Custom/special requirements: +0.1 to +0.2
- Urgent timeline: +0.1
- Historic/specialty home: +0.2 to +0.3

Factors that DECREASE complexity (reduce multiplier):
- New construction: -0.1 to -0.2
- Easy access: -0.1
- Standard replacement (like-for-like): -0.1
- Modern electrical/ductwork: -0.1

Consider:
- Building age and condition
- Access difficulty
- Special requirements
- Existing system condition
- Project type (replacement vs new)

Return JSON with:
{
  "multiplier": 1.25,
  "factors": ["list of factors affecting complexity"],
  "reasoning": "explanation of complexity assessment"
}

Ensure multiplier is between 0.8 and 1.5. Return only JSON, no additional text.`;

    const message = await anthropic.messages.create({
      model: AI_MODEL,
      max_tokens: 400,
      messages: [{
        role: 'user',
        content: prompt
      }]
    });

    // Parse the response
    const responseText = message.content[0].text;
    let complexityResult;

    try {
      complexityResult = JSON.parse(responseText);
    } catch (parseError) {
      console.error('Failed to parse AI response:', responseText);
      return NextResponse.json(
        { success: false, error: 'AI response format error' },
        { status: 500 }
      );
    }

    // Validate and constrain the multiplier
    let multiplier = complexityResult.multiplier || 1.0;
    
    // Ensure multiplier is within valid range
    multiplier = Math.max(0.8, Math.min(1.5, multiplier));
    
    // Round to 2 decimal places
    multiplier = Math.round(multiplier * 100) / 100;

    const cleanedResult = {
      multiplier,
      factors: Array.isArray(complexityResult.factors) 
        ? complexityResult.factors.filter(factor => typeof factor === 'string')
        : [],
      reasoning: complexityResult.reasoning || 'Complexity assessed based on project characteristics'
    };

    return NextResponse.json({
      success: true,
      data: cleanedResult
    });

  } catch (error) {
    console.error('AI complexity calculation error:', error);
    
    return NextResponse.json(
      { 
        success: false, 
        error: 'AI processing temporarily unavailable' 
      },
      { status: 500 }
    );
  }
}