import { NextRequest, NextResponse } from 'next/server';
import { Anthropic } from '@anthropic-ai/sdk';

// Initialize Claude API
const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
});

const AI_MODEL = process.env.AI_MODEL || 'claude-3-haiku-20240307';
const AI_FEATURES_ENABLED = process.env.AI_FEATURES_ENABLED === 'true';

export async function POST(request: NextRequest) {
  try {
    // Check if AI features are enabled
    if (!AI_FEATURES_ENABLED) {
      return NextResponse.json(
        { success: false, error: 'AI features are currently disabled' },
        { status: 503 }
      );
    }

    // Check API key
    if (!process.env.ANTHROPIC_API_KEY) {
      return NextResponse.json(
        { success: false, error: 'AI service not configured' },
        { status: 503 }
      );
    }

    const { notes } = await request.json();

    if (!notes || typeof notes !== 'string') {
      return NextResponse.json(
        { success: false, error: 'Notes text is required' },
        { status: 400 }
      );
    }

    // Check usage limits (implement usage tracking if needed)
    // const usage = await checkAIUsage();
    // if (!usage.allowed) {
    //   return NextResponse.json(
    //     { success: false, error: usage.message },
    //     { status: 429 }
    //   );
    // }

    const prompt = `
Extract lead information from these sales notes and return as JSON:

Notes: "${notes}"

Extract these fields if available:
- firstName: string (first name only)
- lastName: string (last name only)  
- email: string (valid email format)
- phone: string (phone number in any format)
- address: string (street address)
- city: string
- state: string (2-letter code preferred)
- zipCode: string
- interestLevel: "low" | "medium" | "high" (based on urgency, budget mentions, enthusiasm)
- leadSource: string (how they contacted us - call, website, referral, etc.)
- specialRequirements: string[] (any specific needs mentioned)

Rules:
- Only extract information that is clearly stated
- Don't make assumptions or infer information not present
- For interestLevel, consider phrases like "very interested", "high bills", "urgent", "just shopping around"
- For phone numbers, preserve the format found in text
- Return null for fields not found
- Ensure valid JSON format

Return only the JSON object, no additional text.`;

    const message = await anthropic.messages.create({
      model: AI_MODEL,
      max_tokens: 500,
      messages: [{
        role: 'user',
        content: prompt
      }]
    });

    // Parse the response
    const responseText = message.content[0].text;
    let extractedData;

    try {
      extractedData = JSON.parse(responseText);
    } catch (parseError) {
      console.error('Failed to parse AI response:', responseText);
      return NextResponse.json(
        { success: false, error: 'AI response format error' },
        { status: 500 }
      );
    }

    // Validate and clean the extracted data
    const cleanedData = {
      firstName: extractedData.firstName || null,
      lastName: extractedData.lastName || null,
      email: extractedData.email || null,
      phone: extractedData.phone || null,
      address: extractedData.address || null,
      city: extractedData.city || null,
      state: extractedData.state || null,
      zipCode: extractedData.zipCode || null,
      interestLevel: ['low', 'medium', 'high'].includes(extractedData.interestLevel) 
        ? extractedData.interestLevel : 'medium',
      leadSource: extractedData.leadSource || 'manual',
      specialRequirements: Array.isArray(extractedData.specialRequirements) 
        ? extractedData.specialRequirements : []
    };

    return NextResponse.json({
      success: true,
      data: cleanedData,
      extractedFields: Object.keys(cleanedData).filter(key => 
        cleanedData[key as keyof typeof cleanedData] !== null && 
        cleanedData[key as keyof typeof cleanedData] !== ''
      ).length
    });

  } catch (error) {
    console.error('AI lead extraction error:', error);
    
    // Don't expose internal errors to client
    return NextResponse.json(
      { 
        success: false, 
        error: 'AI processing temporarily unavailable' 
      },
      { status: 500 }
    );
  }
}