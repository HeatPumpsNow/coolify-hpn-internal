import { NextRequest, NextResponse } from 'next/server';

const AI_FEATURES_ENABLED = process.env.AI_FEATURES_ENABLED === 'true';

export async function GET(request: NextRequest) {
  try {
    // Check if AI features are enabled
    if (!AI_FEATURES_ENABLED) {
      return NextResponse.json(
        { 
          success: false, 
          status: 'disabled',
          message: 'AI features are currently disabled' 
        },
        { status: 503 }
      );
    }

    // Check API key configuration
    if (!process.env.ANTHROPIC_API_KEY) {
      return NextResponse.json(
        { 
          success: false, 
          status: 'misconfigured',
          message: 'AI service not configured' 
        },
        { status: 503 }
      );
    }

    // Basic health check - could extend to test actual API call
    return NextResponse.json({
      success: true,
      status: 'healthy',
      message: 'AI services available',
      features: {
        leadExtraction: true,
        projectAnalysis: true,
        templateSuggestion: true,
        complexityCalculation: true,
        descriptionGeneration: true
      },
      model: process.env.AI_MODEL || 'claude-3-haiku-20240307',
      timestamp: new Date().toISOString()
    });

  } catch (error) {
    console.error('AI health check error:', error);
    
    return NextResponse.json(
      { 
        success: false, 
        status: 'error',
        message: 'AI health check failed' 
      },
      { status: 500 }
    );
  }
}