import { NextRequest, NextResponse } from 'next/server';
import { Anthropic } from '@anthropic-ai/sdk';

// Initialize Claude API
const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
});

const AI_MODEL = process.env.AI_MODEL || 'claude-3-haiku-20240307';
const AI_FEATURES_ENABLED = process.env.AI_FEATURES_ENABLED === 'true';

export async function POST(request: NextRequest) {
  try {
    // Check if AI features are enabled
    if (!AI_FEATURES_ENABLED) {
      return NextResponse.json(
        { success: false, error: 'AI features are currently disabled' },
        { status: 503 }
      );
    }

    // Check API key
    if (!process.env.ANTHROPIC_API_KEY) {
      return NextResponse.json(
        { success: false, error: 'AI service not configured' },
        { status: 503 }
      );
    }

    const { projectInfo, availableTemplates } = await request.json();

    if (!projectInfo || !availableTemplates || !Array.isArray(availableTemplates)) {
      return NextResponse.json(
        { success: false, error: 'Project info and available templates are required' },
        { status: 400 }
      );
    }

    if (availableTemplates.length === 0) {
      return NextResponse.json(
        { success: false, error: 'No templates available for matching' },
        { status: 400 }
      );
    }

    const prompt = `
You are an HVAC sales assistant. Given project information and available templates, recommend the best template match.

Project Information:
${JSON.stringify(projectInfo, null, 2)}

Available Templates:
${availableTemplates.map((template, idx) => `${idx + 1}. ${template}`).join('\n')}

Template Selection Guidelines:
- "Professional Series" (Good tier): Standard efficiency, reliable, cost-effective
- "Premium Series" (Better tier): High efficiency, quiet operation, advanced features
- For comfort/noise concerns → Premium Series
- For budget-conscious customers → Professional Series  
- For energy efficiency focus → Premium Series
- For standard replacement → Professional Series

Consider these factors:
- Special requirements (quiet operation, energy efficiency, etc.)
- Project type (replacement vs new installation)
- Complexity factors
- System size and building characteristics
- Customer priorities mentioned

Return JSON with:
{
  "templateName": "exact template name from list",
  "confidence": 0.0-1.0,
  "reasoning": "brief explanation of why this template fits",
  "matchedFactors": ["list", "of", "matching", "factors"]
}

Return only the JSON object, no additional text.`;

    const message = await anthropic.messages.create({
      model: AI_MODEL,
      max_tokens: 400,
      messages: [{
        role: 'user',
        content: prompt
      }]
    });

    // Parse the response
    const responseText = message.content[0].text;
    let matchResult;

    try {
      matchResult = JSON.parse(responseText);
    } catch (parseError) {
      console.error('Failed to parse AI response:', responseText);
      return NextResponse.json(
        { success: false, error: 'AI response format error' },
        { status: 500 }
      );
    }

    // Validate the response
    if (!matchResult.templateName || !availableTemplates.includes(matchResult.templateName)) {
      // Fallback to first available template with low confidence
      matchResult = {
        templateName: availableTemplates[0],
        confidence: 0.3,
        reasoning: 'AI could not determine best match, defaulting to first available template',
        matchedFactors: []
      };
    }

    // Ensure confidence is within valid range
    const confidence = Math.max(0, Math.min(1, matchResult.confidence || 0.5));

    const cleanedResult = {
      templateName: matchResult.templateName,
      confidence,
      reasoning: matchResult.reasoning || 'Template suggested based on project characteristics',
      matchedFactors: Array.isArray(matchResult.matchedFactors) 
        ? matchResult.matchedFactors.filter(factor => typeof factor === 'string')
        : []
    };

    return NextResponse.json({
      success: true,
      data: cleanedResult
    });

  } catch (error) {
    console.error('AI template suggestion error:', error);
    
    return NextResponse.json(
      { 
        success: false, 
        error: 'AI processing temporarily unavailable' 
      },
      { status: 500 }
    );
  }
}