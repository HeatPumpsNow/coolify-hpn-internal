import { NextRequest, NextResponse } from 'next/server';
import { Anthropic } from '@anthropic-ai/sdk';

// Initialize Claude API
const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
});

const AI_MODEL = process.env.AI_MODEL || 'claude-3-haiku-20240307';
const AI_FEATURES_ENABLED = process.env.AI_FEATURES_ENABLED === 'true';

export async function POST(request: NextRequest) {
  try {
    // Check if AI features are enabled
    if (!AI_FEATURES_ENABLED) {
      return NextResponse.json(
        { success: false, error: 'AI features are currently disabled' },
        { status: 503 }
      );
    }

    // Check API key
    if (!process.env.ANTHROPIC_API_KEY) {
      return NextResponse.json(
        { success: false, error: 'AI service not configured' },
        { status: 503 }
      );
    }

    const { services, projectInfo, customerName } = await request.json();

    if (!services || !Array.isArray(services) || services.length === 0) {
      return NextResponse.json(
        { success: false, error: 'Services list is required' },
        { status: 400 }
      );
    }

    const prompt = `
Write a professional HVAC quote description for a customer.

Services Selected:
${services.map((service, idx) => `${idx + 1}. ${service}`).join('\n')}

Project Information:
${JSON.stringify(projectInfo, null, 2)}

${customerName ? `Customer Name: ${customerName}` : ''}

Guidelines:
- Write in professional, friendly tone
- Focus on benefits and value, not just features
- Keep it concise (2-3 sentences)
- Emphasize quality, efficiency, and comfort
- Mention energy savings if applicable
- Use Heat Pumps Now brand values: transparency, education, quality

Example format:
"This comprehensive heat pump installation will provide year-round comfort for your [size] home with premium Energy Star certified equipment. Our professional installation includes [key services] ensuring optimal efficiency and reliability. You can expect [benefits like energy savings, quiet operation, etc.] with our industry-leading warranty protection."

Write a similar description based on the selected services and project details. Return only the description text, no additional formatting or explanations.`;

    const message = await anthropic.messages.create({
      model: AI_MODEL,
      max_tokens: 300,
      messages: [{
        role: 'user',
        content: prompt
      }]
    });

    // Get the response text
    const description = message.content[0].text.trim();

    // Basic validation - ensure it's not too short or too long
    if (description.length < 50) {
      return NextResponse.json(
        { success: false, error: 'Generated description too short' },
        { status: 500 }
      );
    }

    if (description.length > 1000) {
      return NextResponse.json(
        { success: false, error: 'Generated description too long' },
        { status: 500 }
      );
    }

    return NextResponse.json({
      success: true,
      data: {
        description,
        wordCount: description.split(' ').length,
        characterCount: description.length
      }
    });

  } catch (error) {
    console.error('AI description generation error:', error);
    
    return NextResponse.json(
      { 
        success: false, 
        error: 'AI processing temporarily unavailable' 
      },
      { status: 500 }
    );
  }
}