import { NextRequest, NextResponse } from 'next/server';
import { Anthropic } from '@anthropic-ai/sdk';

// Initialize Claude API
const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
});

const AI_MODEL = process.env.AI_MODEL || 'claude-3-haiku-20240307';
const AI_FEATURES_ENABLED = process.env.AI_FEATURES_ENABLED === 'true';

export async function POST(request: NextRequest) {
  try {
    // Check if AI features are enabled
    if (!AI_FEATURES_ENABLED) {
      return NextResponse.json(
        { success: false, error: 'AI features are currently disabled' },
        { status: 503 }
      );
    }

    // Check API key
    if (!process.env.ANTHROPIC_API_KEY) {
      return NextResponse.json(
        { success: false, error: 'AI service not configured' },
        { status: 503 }
      );
    }

    const { description } = await request.json();

    if (!description || typeof description !== 'string') {
      return NextResponse.json(
        { success: false, error: 'Project description is required' },
        { status: 400 }
      );
    }

    const prompt = `
Extract HVAC project information from this description and return as JSON:

Description: "${description}"

Extract these fields if clearly stated:
- squareFootage: number (square feet of conditioned space)
- systemCount: number (how many units/systems needed)
- systemSize: string (e.g., "2-ton", "3-ton", "4-ton" or specific BTU)
- equipmentType: string ("heat_pump", "mini_split", "ductless", "air_conditioner", etc.)
- projectType: "replacement" | "new_installation" | "upgrade"
- buildingAge: number (age of building in years, or year built)
- existingSystem: string (current HVAC system description)
- specialRequirements: string[] (quiet operation, energy efficiency, zoning, etc.)
- complexityFactors: string[] (difficult access, old ductwork, electrical issues, etc.)
- urgency: "low" | "medium" | "high" (timeline urgency)

Analysis Guidelines:
- For systemSize: Look for "ton", "BTU", or square footage (1 ton ≈ 400-600 sq ft)
- For projectType: "replacement"=existing system, "new_installation"=new construction, "upgrade"=improving existing
- For complexityFactors: tight spaces, old wiring, ductwork issues, multi-story, crawl space access
- For urgency: "emergency", "asap", "broken" = high; "soon", "this season" = medium; "planning", "future" = low
- Only extract information clearly mentioned, don't assume
- Return null for fields not found

Return only the JSON object, no additional text.`;

    const message = await anthropic.messages.create({
      model: AI_MODEL,
      max_tokens: 600,
      messages: [{
        role: 'user',
        content: prompt
      }]
    });

    // Parse the response
    const responseText = message.content[0].text;
    let extractedData;

    try {
      extractedData = JSON.parse(responseText);
    } catch (parseError) {
      console.error('Failed to parse AI response:', responseText);
      return NextResponse.json(
        { success: false, error: 'AI response format error' },
        { status: 500 }
      );
    }

    // Validate and clean the extracted data
    const cleanedData = {
      squareFootage: typeof extractedData.squareFootage === 'number' && extractedData.squareFootage > 0 
        ? extractedData.squareFootage : null,
      systemCount: typeof extractedData.systemCount === 'number' && extractedData.systemCount > 0 
        ? extractedData.systemCount : null,
      systemSize: extractedData.systemSize || null,
      equipmentType: extractedData.equipmentType || null,
      projectType: ['replacement', 'new_installation', 'upgrade'].includes(extractedData.projectType) 
        ? extractedData.projectType : null,
      buildingAge: typeof extractedData.buildingAge === 'number' && extractedData.buildingAge > 0 
        ? extractedData.buildingAge : null,
      existingSystem: extractedData.existingSystem || null,
      specialRequirements: Array.isArray(extractedData.specialRequirements) 
        ? extractedData.specialRequirements.filter(req => typeof req === 'string') : [],
      complexityFactors: Array.isArray(extractedData.complexityFactors) 
        ? extractedData.complexityFactors.filter(factor => typeof factor === 'string') : [],
      urgency: ['low', 'medium', 'high'].includes(extractedData.urgency) 
        ? extractedData.urgency : 'medium'
    };

    // Calculate confidence score based on extracted fields
    const extractedFieldCount = Object.values(cleanedData).filter(value => {
      if (Array.isArray(value)) return value.length > 0;
      return value !== null && value !== undefined && value !== '';
    }).length;

    const confidenceScore = Math.min(extractedFieldCount / 8, 1); // Max confidence with 8+ fields

    return NextResponse.json({
      success: true,
      data: cleanedData,
      confidence: confidenceScore,
      extractedFieldCount
    });

  } catch (error) {
    console.error('AI project extraction error:', error);
    
    return NextResponse.json(
      { 
        success: false, 
        error: 'AI processing temporarily unavailable' 
      },
      { status: 500 }
    );
  }
}